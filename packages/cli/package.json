{
  "name": "@owear/cli",
  "version": "0.1.2",
  "description": "CLI de Owear: create, dev, build",
  "type": "module",
  "bin": {
    "ow": "./src/ow.js",
    "owear-build-native": "./src/owear-build-native.js"
  },
  "optionalDependencies": {
    "@owear/linux-x64-gnu": "workspace:*",
    "@owear/win32-x64": "workspace:*"
  },
  "files": [
    "src",
    "template"
  ],
  "scripts": {
    "typecheck": "node --check src/ow.js && node --check src/owear-build-native.js"
  },
  "license": "Apache-2.0",
  "homepage": "https://owear.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Scrakk-Team/Owear-Framework.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
